# Normalize all text files to LF on checkin/checkout
* text=auto eol=lf

# Explicit overrides for common binary types (never touch these)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.ico  binary
*.icns binary
*.dylib binary
*.so   binary
*.a    binary
